@page "/Partida/Index"

@inject PartidasService partidasService
@inject NavigationManager navigationManager

<PageTitle>Registro de Partidas</PageTitle>

<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="card-title">Registro de Partidas</h5>
            <a href="/Partida/Create" class="btn btn-primary">
                <span class="bi bi-plus-square mt-1"></span> Crear
            </a>
        </div>

        <div class="card-body">

            <div class="row mb-3">
                <div class="col-3">
                    <label class="col-form-label"><strong>Filtrar por</strong></label>
                    <InputSelect class="form-select" @bind-Value="Filtro">
                        <option value="" selected disabled>Elija una opción</option>
                        <option value="Id">PartidaId</option>
                        <option value="Jugador1">Jugador 1</option>
                        <option value="Jugador2">Jugador 2</option>
                        <option value="Estado">Estado</option>
                    </InputSelect>
                </div>

                <div class="col-4">
                    <label class="col-form-label"><strong>Búsqueda</strong></label>
                    <div class="input-group">
                        <input class="form-control" @bind="ValorFiltro" placeholder="Buscar..." />
                        <button class="btn btn-outline-primary bi bi-search" @onclick="Buscar"></button>
                    </div>
                </div>
            </div>

            <table class="table table-hover">
                <thead class="table table-striped text-black">
                    <tr>
                        <th>PartidaId</th>
                        <th>Jugador 1</th>
                        <th>Jugador 2</th>
                        <th>Estado</th>
                        <th>Fecha Inicio</th>
                        <th>Fecha Fin</th>
                        <th>Opciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var partida in ListaPartidas)
                    {
                        <tr>
                            <td>@partida.PartidaId</td>
                            <td>@partida.Jugador1?.Nombres</td>
                            <td>@partida.Jugador2?.Nombres</td>
                            <td>@partida.EstadoPartida</td>
                            <td>@partida.FechaInicio.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(partida.FechaFin?.ToString("dd/MM/yyyy HH:mm") ?? "En curso")</td>
                            <td class="text-center">
                                <a href="/Partida/Edit/@partida.PartidaId" class="btn btn-outline-primary bi bi-pencil-square"></a>
                                <a href="/Partida/Delete/@partida.PartidaId" class="btn btn-outline-danger bi bi-trash"></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="card-footer d-flex justify-content-between">
            <label><strong>Cantidad:</strong> @ListaPartidas.Count()</label>
        </div>
    </div>
</div>

@code {
    public List<Partidas> ListaPartidas { get; set; } = new List<Partidas>();
    public string Filtro { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        ListaPartidas = await partidasService.Listar(p => p.PartidaId > 0);
    }

    private async Task Buscar()
    {
        if (!string.IsNullOrWhiteSpace(ValorFiltro))
        {
            if (Filtro == "Id" && int.TryParse(ValorFiltro, out int id))
            {
                ListaPartidas = await partidasService.Listar(p => p.PartidaId == id);
            }
            else if (Filtro == "Jugador1")
            {
                ListaPartidas = await partidasService.Listar(p => p.Jugador1.Nombres.ToLower().Contains(ValorFiltro.ToLower()));
            }
            else if (Filtro == "Jugador2")
            {
                ListaPartidas = await partidasService.Listar(p => p.Jugador2.Nombres.ToLower().Contains(ValorFiltro.ToLower()));
            }
            else if (Filtro == "Estado")
            {
                ListaPartidas = await partidasService.Listar(p => p.EstadoPartida.ToLower().Contains(ValorFiltro.ToLower()));
            }
        }
        else
        {
            ListaPartidas = await partidasService.Listar(p => p.PartidaId > 0);
        }
    }

    private async Task Restablecer()
    {
        ListaPartidas = await partidasService.Listar(p => p.PartidaId > 0);
        Filtro = string.Empty;
        ValorFiltro = string.Empty;
    }
}
