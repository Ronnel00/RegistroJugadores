@page "/board/{partidaId:int}"

@rendermode InteractiveServer
@using RegistroJugadores.Models
@inject RegistroJugadores.Services.PartidasService partidasService
@inject RegistroJugadores.Services.JugadoresService jugadoresService
@inject NavigationManager NavManager

<div class="container mx-auto max-w-lg p-6 bg-white rounded-lg shadow-xl text-center">
    @if (!cargado)
    {
        <p>Cargando...</p>
    }
    else
    {
        <div class="game-screen">
            <h2 class="game-status">@GameStatus</h2>

            <div class="game-board">
                @for (var i = 0; i < 9; i++)
                {
                    var idx = i;
                    <button class="cell @GetPlayerClass(board[idx])"
                            @onclick="() => HandleCellClick(idx)"
                            disabled="@(board[idx] != null || winner != null || esEmpate)">
                        @board[idx]?.ToString()
                    </button>
                }
            </div>

            <div class="mt-4">
                <button class="btn btn-secondary" @onclick="ReiniciarLocal">Reiniciar Juego</button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int partidaId { get; set; }

    private enum PlayerType { X, O }

    private PlayerType?[] board = new PlayerType?[9];
    private PlayerType _currentPlayerType = PlayerType.X;
    private PlayerType? winner;
    private bool esEmpate;
    private bool cargado = false;

    private Partidas partida;
    private Jugadores jugador1;
    private Jugadores? jugador2;

    private string GameStatus
    {
        get
        {
            if (winner != null)
            {
                var nombreGanador = winner == PlayerType.X ? jugador1?.Nombres ?? "Jugador X" : jugador2?.Nombres ?? "Jugador O";
                return $"🏆 ¡Ganador: {nombreGanador}!";
            }

            if (esEmpate)
                return "🤝 ¡Empate!";

            var nombreTurno = _currentPlayerType == PlayerType.X ? jugador1?.Nombres ?? "Jugador X" : jugador2?.Nombres ?? "Jugador O";
            return $"Turno de: {nombreTurno}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        partida = await partidasService.Buscar(partidaId);
        if (partida == null)
        {
            NavManager.NavigateTo("/");
            return;
        }

        jugador1 = await jugadoresService.Buscar(partida.Jugador1Id);
        if (partida.Jugador2Id.HasValue)
            jugador2 = await jugadoresService.Buscar(partida.Jugador2Id.Value);

        if (string.IsNullOrEmpty(partida.EstadoTablero) || partida.EstadoTablero.Length != 9)
            partida.EstadoTablero = "---------";

        for (int i = 0; i < 9; i++)
        {
            var ch = partida.EstadoTablero[i];
            if (ch == 'X') board[i] = PlayerType.X;
            else if (ch == 'O') board[i] = PlayerType.O;
            else board[i] = null;
        }

        _currentPlayerType = partida.TurnoJugadorId == partida.Jugador1Id ? PlayerType.X : PlayerType.O;
        cargado = true;
    }

    private async Task HandleCellClick(int index)
    {
        if (board[index] != null || winner != null || esEmpate) return;

        board[index] = _currentPlayerType;
        partida.EstadoTablero = BoardToString();

        winner = CheckForWinner();
        if (winner != null)
        {
            partida.GanadorId = winner == PlayerType.X ? partida.Jugador1Id : partida.Jugador2Id;
            partida.EstadoPartida = "Finalizada";
            partida.FechaFin = DateTime.UtcNow;
            await ManejarResultadosAsync();
            await partidasService.Guardar(partida);
            return;
        }

        esEmpate = board.All(c => c != null);
        if (esEmpate)
        {
            partida.GanadorId = null;
            partida.EstadoPartida = "Finalizada";
            partida.FechaFin = DateTime.UtcNow;
            await ManejarResultadosAsync();
            await partidasService.Guardar(partida);
            return;
        }

        _currentPlayerType = (_currentPlayerType == PlayerType.X) ? PlayerType.O : PlayerType.X;
        partida.TurnoJugadorId = _currentPlayerType == PlayerType.X ? partida.Jugador1Id : (partida.Jugador2Id ?? partida.Jugador1Id);
        await partidasService.Guardar(partida);
    }

    private string BoardToString()
    {
        var arr = new char[9];
        for (int i = 0; i < 9; i++)
        {
            arr[i] = board[i] == PlayerType.X ? 'X' : (board[i] == PlayerType.O ? 'O' : '-');
        }
        return new string(arr);
    }

    private async Task ManejarResultadosAsync()
    {
        jugador1 = await jugadoresService.Buscar(partida.Jugador1Id);
        Jugadores? jugadorGanador = null;
        Jugadores? jugadorPerdedor = null;

        if (esEmpate)
        {
            jugador1.Empates++;
            if (jugador2 != null) jugador2.Empates++;
            await jugadoresService.Guardar(jugador1);
            if (jugador2 != null) await jugadoresService.Guardar(jugador2);
            return;
        }

        if (partida.GanadorId.HasValue)
        {
            if (partida.GanadorId == partida.Jugador1Id)
            {
                jugadorGanador = jugador1;
                jugadorPerdedor = jugador2;
            }
            else
            {
                jugadorGanador = jugador2;
                jugadorPerdedor = jugador1;
            }

            if (jugadorGanador != null)
            {
                jugadorGanador.Victorias++;
                await jugadoresService.Guardar(jugadorGanador);
            }

            if (jugadorPerdedor != null)
            {
                jugadorPerdedor.Derrotas++;
                await jugadoresService.Guardar(jugadorPerdedor);
            }
        }
    }

    private PlayerType? CheckForWinner()
    {
        int[][] lines = {
            new[]{0,1,2}, new[]{3,4,5}, new[]{6,7,8},
            new[]{0,3,6}, new[]{1,4,7}, new[]{2,5,8},
            new[]{0,4,8}, new[]{2,4,6}
    };

        foreach (var line in lines)
        {
            var a = line[0];
            var b = line[1];
            var c = line[2];
            if (board[a].HasValue && board[a] == board[b] && board[a] == board[c])
                return board[a];
        }
        return null;
    }

    private void ReiniciarLocal()
    {
        board = new PlayerType?[9];
        _currentPlayerType = PlayerType.X;
        winner = null;
        esEmpate = false;
        partida.EstadoTablero = "---------";
        partida.TurnoJugadorId = partida.Jugador1Id;
    }

    private string GetPlayerClass(PlayerType? player)
    {
        if (!player.HasValue) return "";
        return player == PlayerType.X ? "player-x" : "player-o";
    }
}
